# Backup Organizer — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Caminho do banco SQLite (padrão: raiz do projeto)
DB_PATH=backup_organizer.db

# Endereço do Ollama (Windows com WSL2: usar host.docker.internal)
# Se rodar direto no Windows: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Modelo Ollama a usar (deve estar instalado: ollama pull llama3.1)
OLLAMA_MODEL=llama3.1
